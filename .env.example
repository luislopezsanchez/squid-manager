# ============================================
# SquidManager - Variables de entorno
# ============================================
# Copia este archivo a .env y ajusta los valores.
# El .env NO se sube al repositorio (está en .gitignore).

# --- Base de datos ---
DB_NAME=squidmanager
DB_USER=squid
# OBLIGATORIO. Genera una con: openssl rand -hex 16
DB_PASS=

# --- Seguridad ---
# OBLIGATORIO. Clave de firma de los JWT. Genera una con: openssl rand -hex 32
# Si se deja la de ejemplo, cualquiera puede fabricarse un token de admin.
SECRET_KEY=
# Minutos de validez de la sesión del panel (480 = 8 horas)
TOKEN_EXPIRE=480

# Contraseña inicial del usuario 'admin'. Si se deja vacía se genera una
# aleatoria y aparece UNA sola vez en el log del backend:
#   docker compose logs backend | grep -A3 "Administrador inicial"
# En cualquier caso se pide cambiarla en el primer inicio de sesión.
ADMIN_INITIAL_PASSWORD=

# Coste de bcrypt para las contraseñas de los usuarios del proxy.
# Más alto = más lento de romper, y también de verificar. 12 es lo recomendado.
BCRYPT_COST=12

# Orígenes permitidos por CORS, separados por comas. Déjalo vacío si accedes
# al panel por su propia URL: el frontend y la API comparten origen.
CORS_ORIGINS=

# Hosts cuya cabecera X-Forwarded-For se considera de fiar. Es el proxy que
# tienes delante; si añades otro, ponlo aquí o el límite de intentos de login
# se podrá esquivar falsificando la cabecera.
TRUSTED_PROXY_HOSTS=frontend

# Modo depuración. En true expone /docs sin autenticación: solo para desarrollo.
DEBUG=false

# --- Puertos ---
# Puerto del panel web
WEB_PORT=3000

# Puerto del proxy Squid.
# Si cambias el puerto en el panel, actualiza también SQUID_PORT aquí para que
# el contenedor conserve el mapeo tras un `docker compose up -d`.
SQUID_PORT=3128
PROXY_PORT=3128
