# ============================================
# SquidManager - Configuración de entorno
# ============================================
# Copia este archivo a .env y ajusta los valores
# cp .env.example .env
# ============================================

# --------------------------------------------
# Base de datos PostgreSQL
# --------------------------------------------
# Nombre de la base de datos
DB_NAME=squidmanager
# Usuario de la base de datos
DB_USER=squid
# Contraseña de la base de datos (¡cambiar en producción!)
DB_PASS=squidpass123

# --------------------------------------------
# Seguridad del panel web
# --------------------------------------------
# Clave secreta para JWT (¡cambiar por una cadena aleatoria de 64 chars en producción!)
# Generar con: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-64-char-string-in-production
# Tiempo de expiración del token JWT en minutos (480 = 8 horas)
TOKEN_EXPIRE=480

# --------------------------------------------
# Puerto del proxy Squid
# --------------------------------------------
# Puerto que Squid escucha dentro del contenedor
# Si cambias este valor desde el panel web, también debes actualizarlo aquí
# y pulsar "Aplicar Cambios" (el sistema recrea el contenedor automáticamente)
SQUID_PORT=3128
# Puerto que se publica al host (normalmente igual a SQUID_PORT)
PROXY_PORT=3128

# --------------------------------------------
# NOTAS:
# --------------------------------------------
# - El primer arranque compila Squid desde el código fuente (~10-15 min)
# - Las credenciales por defecto del panel son: admin / admin123
# - El certificado CA de SSL Bump se genera automáticamente al arrancar
# - Para cambiar el puerto del proxy: cambia SQUID_PORT + PROXY_PORT aquí
#   Y también cambia http_port en el panel → Configuración → Aplicar Cambios