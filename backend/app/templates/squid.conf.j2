{# Template Jinja2 para generar squid.conf #}
{# Generado dinámicamente por SquidManager #}

# ============================================
# SquidManager - Configuración generada automáticamente
# NO EDITAR MANUALMENTE - Usar el panel web
# ============================================

# --- Puerto de escucha con SSL Bump ---
{% if modo_despliegue == 'native' %}
# Instalación nativa: Squid escucha directamente en el puerto que se elige
# desde el panel, sin ninguna traducción de por medio.
{% else %}
# Este puerto es FIJO y es interno al contenedor: no es el puerto al que se
# conectan los clientes. El que se elige desde el panel es el que Docker
# publica hacia fuera, y se mapea contra este.
#
# Antes este valor salía de la base de datos, y entonces el puerto vivía en dos
# sitios que había que mantener sincronizados a mano: aquí y en el mapeo de
# Docker. Cuando divergían, Docker publicaba un puerto donde Squid ya no
# escuchaba y el proxy quedaba inalcanzable sin que nada lo avisara.
{% endif %}
http_port {{ internal_port }} ssl-bump \
  generate-host-certificates=on \
  cert=/etc/squid/ssl_cert/squid-ca.crt \
  key=/etc/squid/ssl_cert/squid-ca.key

# --- Autenticación combinada (local + LDAP) ---
# Un único helper que consulta local (htpasswd) primero y luego LDAP.
# Squid solo soporta UN helper de auth básica; por eso usamos uno combinado.
#
# Este bloque va ANTES del de SSL Bump a propósito: Squid lee el fichero en
# orden, y una ACL de usuario (proxy_auth) no se puede declarar mientras no
# exista un esquema de autenticación. Poniéndolo después, cualquier regla de
# interceptación por usuario aborta el arranque con «Invalid ACL».
{% if settings.get('proxy_auth_scheme', 'basic') != 'none' %}
{% if kerberos_esta_activo %}
# Negotiate (Kerberos/SPNEGO) va ANTES que basic: los navegadores que lo
# soportan y están en el dominio lo intentan primero y entran sin que se les
# pida nada; el resto (móviles, Linux fuera del dominio, invitados) cae solo
# al basic de abajo. No sustituye a basic, coexiste con él.
auth_param negotiate program /usr/lib/squid/negotiate_kerberos_auth -k /etc/squid/HTTP.keytab -s HTTP/{{ kerberos.proxy_fqdn }}@{{ kerberos.realm }}
auth_param negotiate children 10
auth_param negotiate keep_alive on
{% endif %}
{% if settings.get('proxy_auth_scheme', 'basic') == 'digest' %}
# Digest (RFC 2617): igual que basic pero Squid nunca ve la contraseña en
# claro del cliente -solo el HA1 que ya calculó el backend al crear el
# usuario (ver routes/proxy_users.py:_generate_digest_ha1). Reemplaza a
# basic, no coexiste con él: HTTP solo permite un esquema "no-negotiate"
# activo a la vez para no confundir a los navegadores que solo entienden el
# primero que ven (mismo motivo que el orden Negotiate > Digest > Basic de
# arriba). Solo usuarios LOCALES: no hay soporte de LDAP con Digest, porque
# exigiría que el directorio guarde el HA1 en un atributo no estándar.
auth_param digest program /usr/lib/squid/squidmanager_digest_helper
auth_param digest children {{ settings.get('auth_children', '5') }}
auth_param digest realm {{ settings.get('auth_realm', 'SquidManager Proxy') }}
auth_param digest nonce_garbage_interval 5 minutes
auth_param digest nonce_max_duration 30 minutes
auth_param digest nonce_max_count 50
{% else %}
auth_param basic program /usr/lib/squid/squidmanager_auth_helper
auth_param basic children {{ settings.get('auth_children', '5') }}
auth_param basic realm {{ settings.get('auth_realm', 'SquidManager Proxy') }}
auth_param basic credentialsttl {{ settings.get('credentialsttl', '2 hours') }}
{% endif %}
{% else %}
# proxy_auth_scheme = 'none': este Squid no pide usuario/contraseña propios.
# Sin auth_param configurado, cualquier ACL de tipo proxy_auth abortaría el
# arranque ("authentication scheme not configured") -por eso mas abajo, con
# 'none', ni se declara la ACL 'authenticated' ni los grupos de usuarios.
# El control de acceso real lo hace el proxy padre (ver validar_proxy_auth_scheme_none
# en parent_proxy_service.py, que exige uno configurado y habilitado antes
# de permitir este modo) o la red que rodea a este Squid.
{% endif %}

# --- Configuración SSL Bump ---
acl step1 at_step SslBump1
acl step2 at_step SslBump2
acl step3 at_step SslBump3

# ACLs de SNI para aplicar las políticas de dominio también a HTTPS. Solo se
# declara para una ACL que de verdad aparece en alguna regla http_access
# (domain_acls_used, ver config_generator.py): una ACL de dominio que existe
# pero que ninguna regla usa todavía no necesita su variante SNI, y con una
# lista de millones de dominios declararla igual le costaba a Squid parsear
# ese mismo archivo grande una segunda vez para nada.
{% for acl in acls %}
{% if acl.name in domain_acls_used %}
{% if acl.type == 'dstdomain' %}
{% if acl.source == 'file' %}
acl sni_{{ acl.name }} ssl::server_name "/etc/squid/acl_lists/{{ acl.name }}.txt"
{% else %}
acl sni_{{ acl.name }} ssl::server_name {{ acl.value }}
{% endif %}
{% elif acl.type == 'dstdom_regex' %}
{% if acl.source == 'file' %}
acl sni_{{ acl.name }} ssl::server_name_regex "/etc/squid/acl_lists/{{ acl.name }}.txt"
{% else %}
acl sni_{{ acl.name }} ssl::server_name_regex {{ acl.value }}
{% endif %}
{% endif %}
{% endif %}
{% endfor %}

{% if ssl_exclude %}
# Dominios que NO se descifran: banca, sanidad y aplicaciones que fijan el
# certificado (pinning) dejan de funcionar si se interceptan.
acl ssl_exclude ssl::server_name {{ ssl_exclude|join(' ') }}
{% endif %}

# Bloqueo de HTTPS por SNI: si el nombre coincide con un dominio denegado se
# corta en el paso 2, sin llegar a descifrar la conexión.
{% for name in terminate_acls %}
ssl_bump terminate step2 sni_{{ name }}
{% endfor %}

{% if ssl_bump_enabled %}
{% for group in groups_sin_bump %}
# Miembros de «{{ group.name }}»: su tráfico HTTPS no se descifra.
acl nobump_{{ group.name }} proxy_auth {{ group.members|join(' ') if group.members else '__EMPTY_GROUP__' }}
{% endfor %}
# Peek: ver el SNI del cliente
ssl_bump peek step1 all
{% for group in groups_sin_bump %}
# Se deja pasar cifrado de extremo a extremo. Va después del `terminate` de
# más arriba, así que el bloqueo por dominio le sigue afectando: quedar exento
# del descifrado no es quedar exento del filtrado.
ssl_bump splice step2 nobump_{{ group.name }}
{% endfor %}
{% if ssl_exclude %}
# Los dominios excluidos se dejan pasar cifrados de extremo a extremo.
ssl_bump splice step2 ssl_exclude
{% endif %}
# Stare: permitir que el servidor envíe su certificado
ssl_bump stare step2 all
# Bump: interceptar y desencriptar el resto
ssl_bump bump step3 all
{% else %}
# Interceptación de HTTPS desactivada: Squid solo tuneliza.
#
# Squid únicamente puede interceptar HTTPS una vez en una cadena de proxies. Si
# este sale a través de otro que también intercepta, el de arriba recibe la
# petición descifrada dentro de un túnel que él mismo cifró y la rechaza con un
# 403 que no explica nada.
#
# Con esto no se puede filtrar por dominio dentro de HTTPS —el bloqueo por SNI
# de más arriba sigue funcionando, porque actúa antes de descifrar—, pero el
# tráfico pasa.
ssl_bump splice all
{% endif %}

# Generador de certificados dinámicos (base persistente en el volumen)
sslcrtd_program /usr/lib/squid/security_file_certgen -s /var/lib/ssl_crtd/db -M 4MB
sslcrtd_children 5

# --- ACLs predefinidas ---
acl localnet src 10.0.0.0/8
acl localnet src 172.16.0.0/12
acl localnet src 192.168.0.0/16
acl localnet src fc00::/7
acl localnet src fe80::/10
acl SSL_ports port 443
acl Safe_ports port 80          # http
acl Safe_ports port 443         # https
acl Safe_ports port 21          # ftp
acl Safe_ports port 70          # gopher
acl Safe_ports port 210         # wais
acl Safe_ports port 1025-65535  # unregistered ports
acl Safe_ports port 280         # http-mgmt
acl Safe_ports port 488         # gss-http
acl Safe_ports port 591         # filemaker
acl Safe_ports port 777         # multiling http
acl CONNECT method CONNECT
{% if settings.get('proxy_auth_scheme', 'basic') != 'none' %}
acl authenticated proxy_auth REQUIRED
{% endif %}

# --- ACLs personalizadas (desde BD) ---
{% for acl in acls %}
{% if acl.source == 'file' %}
acl {{ acl.name }} {{ acl.type }} "/etc/squid/acl_lists/{{ acl.name }}.txt"
{% else %}
acl {{ acl.name }} {{ acl.type }} {{ acl.value }}
{% endif %}
{% endfor %}

{% if settings.get('proxy_auth_scheme', 'basic') != 'none' %}
# --- Grupos de usuarios (ACLs proxy_auth) ---
# Siempre se genera la ACL del grupo (incluso vacío) para evitar "ACL not found"
# si una regla lo referencia. El placeholder __EMPTY_GROUP__ no coincide con nadie.
# Con 'none' no se declaran: no hay auth_param configurado, y una ACL
# proxy_auth sin esquema aborta el arranque de Squid.
{% for group in groups %}
acl {{ group.name }} proxy_auth {{ group.members|join(' ') if group.members else '__EMPTY_GROUP__' }}
{% endfor %}
{% endif %}

# --- Reglas de acceso (http_access) ---
http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access allow localhost manager
http_access deny manager

{% if trusted_sources %}
# Orígenes que no tienen que autenticarse. Va ANTES de exigir credenciales: si
# fuera después, no serviría de nada, porque a estas peticiones nunca se les
# llegaría a preguntar.
#
# Pensado para un proxy hijo que ya autentica a sus usuarios: el padre no puede
# volver a pedir credenciales cuando el tráfico viaja dentro de un túnel TLS
# interceptado, y sin esta exención lo deniega con un 403.
acl origenes_confianza src {{ trusted_sources|join(' ') }}
http_access allow origenes_confianza

{% endif %}
{% if auth_exempt_domains %}
# Destinos que no piden credenciales sin importar quién los pida (a diferencia
# de origenes_confianza, que exime por IP de ORIGEN). Pensado para destinos
# que no saben presentar credenciales de proxy: Windows Update, telemetría de
# Office, un SaaS sin proxy-auth. Va antes de exigir autenticación por el
# mismo motivo que origenes_confianza: después de la línea de abajo, ya sería
# tarde para eximir a nadie.
acl exentos_auth_dominio dstdomain {{ auth_exempt_domains|join(' ') }}
http_access allow exentos_auth_dominio

{% endif %}
{% if settings.get('proxy_auth_scheme', 'basic') != 'none' %}
# Pedir credenciales una sola vez, antes de evaluar las reglas del panel.
# A partir de aquí todas las peticiones llegan ya autenticadas, así que un
# "deny <grupo>" devuelve 403 y no un 407 en bucle. Esto permite respetar el
# orden de las reglas tal como se ve en el panel.
http_access deny !authenticated
{% endif %}

{% for rule in rules %}
http_access {{ rule.action }} {{ rule.acl_names }}
{% endfor %}

{% if settings.get('proxy_auth_scheme', 'basic') != 'none' %}
# Lo que ninguna regla haya denegado, se permite a los usuarios autenticados.
http_access allow authenticated
{% else %}
# 'none': no se exige autenticación local -el control de acceso real lo hace
# el proxy padre (validado como obligatorio para este modo) o la red que
# rodea a este Squid-. Lo que ninguna regla haya denegado, se permite tal
# cual, sin pedir usuario.
http_access allow all
{% endif %}
http_access deny all

{% if parent_proxy and parent_proxy.enabled and parent_proxy.host %}
# --- Salida a Internet a través de otro proxy ---
# En redes donde el cortafuegos cierra la salida directa, todo el tráfico tiene
# que pasar por el proxy corporativo.
#
# El 0 es el puerto ICP, que no se usa: `no-query` desactiva ese sondeo, y
# `default` marca a este peer como la salida a usar cuando no hay otra regla.
{% if parent_proxy.auth_method == 'passthru' %}
{# PASSTHRU reenvia tal cual las credenciales que ya trae el cliente: la unica
   forma de llegar a un padre que exige Digest/NTLM/Negotiate, porque
   login=user:pass de cache_peer solo sabe presentar Basic
   (https://www.squid-cache.org/Doc/config/cache_peer/). connection-auth=on
   es obligatorio para que PASSTHRU funcione con algo que no sea Basic. La
   compatibilidad con la auth local de este Squid ya se valido antes de
   llegar aqui (ver parent_proxy_service.validar_auth_method_compatible). #}
cache_peer {{ parent_proxy.host }} parent {{ parent_proxy.port }} 0 no-query default login=PASSTHRU connection-auth=on
{% else %}
cache_peer {{ parent_proxy.host }} parent {{ parent_proxy.port }} 0 no-query default{% if parent_proxy.username %} login={{ parent_proxy.username }}:{{ parent_proxy.password or '' }}{% endif %}
{% endif %}

{% if parent_ca %}
# El proxy padre también intercepta HTTPS, así que al reenviarle el tráfico
# presenta su propio certificado. Sin declararlo aquí, Squid lo rechaza por
# autofirmado (X509_V_ERR_SELF_SIGNED_CERT_IN_CHAIN) y no carga ninguna web
# HTTPS. Los certificados del sistema se siguen usando: este se añade.
tls_outgoing_options cafile=/etc/squid/parent_ca.crt
{% endif %}

{% if direct_domains %}
# Destinos que NO pasan por el padre: la intranet, normalmente.
acl salida_directa dstdomain {{ direct_domains|join(' ') }}
always_direct allow salida_directa
{% endif %}
{% if parent_proxy.never_direct %}
# Sin salida directa de reserva: si el cortafuegos la bloquea —lo habitual
# cuando hay proxy corporativo—, intentarla solo añade una espera antes de
# fallar igual. O pasa por el padre, o no pasa.
never_direct allow all
{% endif %}
{% endif %}

# --- Configuración de caché ---
cache_mem {{ settings.get('cache_mem', '128 MB') }}
{% if settings.get('cache_dir') %}
cache_dir {{ settings.get('cache_dir', 'ufs /var/spool/squid 100 16 256') }}
{% endif %}
maximum_object_size {{ settings.get('maximum_object_size', '4 MB') }}

{% if delay_pools and delay_pools|length > 0 %}
# --- Delay Pools (control de ancho de banda) ---
delay_pools {{ delay_pools|length }}
{% for pool in delay_pools %}
delay_class {{ loop.index }} {{ pool.pool_class }}
delay_parameters {{ loop.index }} {{ pool.parameters }}
delay_access {{ loop.index }} allow {{ pool.acl_name if pool.acl_name else 'all' }}
delay_access {{ loop.index }} deny all
{% endfor %}
{% endif %}

# --- Logging ---
# El prefijo stdio: es el módulo de escritura; sin él Squid avisa en cada arranque.
access_log stdio:{{ settings.get('access_log', '/var/log/squid/access.log') }}
cache_log {{ settings.get('cache_log', '/var/log/squid/cache.log') }}

# De la rotacion se encarga logrotate (ver squid/squid-logrotate), no Squid.
# Con 0, `squid -k rotate` se limita a cerrar y reabrir los ficheros sin
# renumerarlos, que es justo lo que hace falta cuando rota otro. Con el valor
# por defecto rotan los dos a la vez y las numeraciones se pisan entre si.
logfile_rotate 0
{% if settings.get('cache_store_log') and settings.get('cache_store_log') != 'none' %}
cache_store_log stdio:{{ settings.get('cache_store_log') }}
{% else %}
# store.log genera mucha escritura y no lo consume nadie: desactivado.
cache_store_log none
{% endif %}

# --- Resolución de nombres ---
{% if dns_nameservers %}
# Servidores DNS a los que Squid pregunta, en lugar del resolutor del sistema.
# Squid reparte las consultas entre todos los de la lista: si se quiere que
# TODO el tráfico pase por un filtro (un Pi-hole, por ejemplo), debe ser el
# único de la lista. Añadir uno público como respaldo mejora la disponibilidad
# pero deja pasar sin filtrar la parte de consultas que le toquen.
dns_nameservers {{ dns_nameservers|join(' ') }}
{% else %}
# Sin servidores propios configurados: Squid usa la resolución del sistema.
{% endif %}

# --- Misc ---
coredump_dir /var/spool/squid
refresh_pattern {{ settings.get('refresh_pattern', '. 0 20% 4320') }}
visible_hostname {{ settings.get('visible_hostname', 'squidmanager') }}
# Idioma de las páginas de error. Squid no hace fallback de es-ES a es, así que
# se fija explícitamente en lugar de negociarlo con el navegador.
error_default_language {{ settings.get('error_language', 'es') }}
